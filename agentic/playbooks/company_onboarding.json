{
  "name": "company_onboarding",
  "version": "1.3.0",
  "language": "de",
  "phases": [
    {
      "id": "p1",
      "ordinal": 1,
      "title": "Unternehmensprofil",
      "gate_id": "g1",
      "steps": [
        {
          "id": "s1_company_name",
          "ordinal": 1,
          "title": "Firmierung",
          "prompt": "Wie lautet die vollständige Firmierung Ihres Unternehmens?",
          "objective": "vollständige Firmierung inklusive Rechtsform",
          "success_criteria": ["Firmenname mit Rechtsform genannt"]
        },
        {
          "id": "s2_company_confirm",
          "ordinal": 2,
          "title": "Registerabgleich",
          "prompt": "Ich habe folgende Registerdaten gefunden. Ist das Ihr Unternehmen?",
          "objective": "Bestätigung oder Ablehnung des Registertreffers",
          "options": ["ja", "nein"],
          "uses_research": true
        },
        {
          "id": "s3_industry_size",
          "ordinal": 3,
          "title": "Branche und Größe",
          "prompt": "In welcher Branche sind Sie tätig und wie viele Mitarbeitende haben Sie ungefähr?",
          "objective": "Branche und ungefähre Mitarbeiterzahl",
          "success_criteria": ["Branche genannt", "Mitarbeiterzahl oder Größenordnung genannt"]
        }
      ]
    },
    {
      "id": "p2",
      "ordinal": 2,
      "title": "Projektsteckbrief",
      "gate_id": "g2",
      "steps": [
        {
          "id": "s4_main_goal",
          "ordinal": 1,
          "title": "Ziel",
          "prompt": "Welches Ziel soll das Data-&-AI-Vorhaben in den nächsten sechs Monaten erreichen?",
          "objective": "messbares Ziel des Vorhabens",
          "success_criteria": ["konkretes Ziel genannt"]
        },
        {
          "id": "s5_data_landscape",
          "ordinal": 2,
          "title": "Datenlandschaft",
          "prompt": "Welche Systeme und Datenquellen sind beteiligt, zum Beispiel SAP, Excel, Sensoren oder ein Data Warehouse?",
          "objective": "beteiligte Systeme und Datenquellen",
          "success_criteria": ["mindestens ein System oder eine Datenquelle genannt"]
        },
        {
          "id": "s6_constraints",
          "ordinal": 3,
          "title": "Rahmenbedingungen",
          "prompt": "Welche Rahmenbedingungen gibt es, etwa Budget, Cloud-Vorgaben oder Datenschutzanforderungen?",
          "objective": "Budget-, Cloud- oder Datenschutzvorgaben",
          "success_criteria": ["mindestens eine Rahmenbedingung genannt"]
        }
      ]
    }
  ],
  "gates": [
    {"id": "g1", "title": "Unternehmensprofil bestätigen", "required_step_ids": ["s1_company_name", "s2_company_confirm", "s3_industry_size"]},
    {"id": "g2", "title": "Projektsteckbrief bestätigen", "required_step_ids": ["s4_main_goal", "s5_data_landscape", "s6_constraints"]}
  ]
}
